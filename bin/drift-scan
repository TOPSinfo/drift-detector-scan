#!/usr/bin/env bash
# Self-bootstrapping runner for Drift Detector.
#
# Provisions a local virtualenv (once) with the runtime deps, fetches the
# ast-grep scan engine (a static binary), then runs `agent.cli inventory-scan`. Designed to
# work from ANY working directory a teammate invokes it in: the `agent` package
# is made importable via PYTHONPATH (not cwd), catalog files resolve
# package-relative, and relative --root/--out paths still resolve against the
# caller's cwd because we do NOT chdir.
#
# PYTHONSAFEPATH=1 is what makes that first claim TRUE. `python -m` prepends the
# caller's cwd to sys.path AHEAD of PYTHONPATH, so running from any directory that
# happens to contain an `agent/` package silently executed THAT engine and its
# catalogs — a green, deterministic, wrong report that `verify` cannot catch,
# because the hijacking engine verifies its own output. Do not remove it.
#
# Usage:
#   drift-scan doctor              # check prerequisites, print exact fixes
#   drift-scan [inventory-scan flags]   # e.g. --root --state --out-json --now
set -euo pipefail

# Repo root, derived from this script's location (bin/ -> root). Run from any cwd.
ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

VENV="$ROOT/.venv"
MARKER="$VENV/.drift-deps-ok"
REQ="$ROOT/requirements-plugin.txt"
PYVER="3.12"   # tomllib needs >=3.11

_UV_HINT='  • uv (recommended — also provides Python, no system packages needed):
      curl -LsSf https://astral.sh/uv/install.sh | sh
      # then restart your shell (or: source ~/.bashrc / ~/.zshrc)

  • or Python 3.11+ with venv support, e.g. on Debian/Ubuntu:
      sudo apt install python3.12-venv'

# ---------- doctor: environment health check (does NOT provision) ----------
if [ "${1:-}" = "doctor" ]; then
  set +e
  echo "drift-detector · doctor"
  echo "  root        : $ROOT"
  ready=0
  if command -v uv >/dev/null 2>&1; then
    echo "  uv          : $(uv --version 2>/dev/null) — ok (provisions Python)"
    ready=1
  else
    echo "  uv          : not found"
  fi
  PY="${DRIFT_PYTHON:-python3}"
  if command -v "$PY" >/dev/null 2>&1; then
    pv="$("$PY" -c 'import sys;print("%d.%d"%sys.version_info[:2])' 2>/dev/null)"
    if "$PY" -c 'import sys;raise SystemExit(0 if sys.version_info[:2]>=(3,11) else 1)' 2>/dev/null; then
      if "$PY" -c 'import ensurepip, venv' 2>/dev/null; then
        echo "  python3     : $pv (+venv) — ok"
        [ "$ready" = "0" ] && ready=1
      else
        echo "  python3     : $pv — missing venv/ensurepip module"
      fi
    else
      echo "  python3     : $pv — too old (need >=3.11)"
    fi
  else
    echo "  python3     : not found"
  fi
  if [ -f "$MARKER" ]; then
    # report the engine the scanner will ACTUALLY resolve, not just what pip installed
    eng="$(env PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$VENV/bin/python" -c \
          'from agent.lib.scan_util import resolve_engine; print(resolve_engine())' 2>/dev/null)"
    if [ -n "$eng" ]; then
      case "$(basename "$eng")" in
        ast-grep|sg) echo "  engine      : ast-grep ($("$eng" --version 2>/dev/null)) — ok (preferred: static binary)" ;;
        *)           echo "  engine      : $(basename "$eng") — unexpected (ast-grep is the supported engine)" ;;
      esac
    else
      echo "  engine      : none resolvable — scans will fail"
    fi
  else
    echo "  engine      : not yet — provisioned on first scan"
  fi
  # gitleaks is optional (secret detection degrades gracefully without it — a repo's
  # secrets count reads UNKNOWN, not zero, per agent/lib/secrets_scan.py), but nothing else
  # says so, so an operator has no way to learn the feature is inert on their machine short
  # of reading stderr on a scan they may not be watching. Fetched into the venv's bin/ on
  # first scan (below) — report what the scanner will ACTUALLY resolve, the same way the
  # `engine` line above does for ast-grep, not just a bare PATH check (which would miss a
  # copy already sitting in the venv before the venv's own python can be asked).
  if [ -f "$MARKER" ]; then
    gl="$(env PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$VENV/bin/python" -c \
         'from agent.lib.secrets_scan import _resolve_gitleaks; print(_resolve_gitleaks())' 2>/dev/null)"
    if [ -n "$gl" ] && { [ -x "$gl" ] || command -v "$gl" >/dev/null 2>&1; }; then
      echo "  secrets     : gitleaks ($("$gl" version 2>/dev/null)) — ok"
    else
      echo "  secrets     : gitleaks not found — secret detection will report UNKNOWN, not zero"
    fi
  else
    echo "  secrets     : not yet — fetched on first scan (best-effort; optional)"
  fi
  # Freshness. Network-OPTIONAL by design: a check that fails the run when offline is a check
  # people disable. Offline prints one plain line; it never changes doctor's exit code.
  # Uses system python3, not the venv's, deliberately: freshness_check imports nothing but
  # stdlib `re`, and doctor must work before the venv exists (first run, offline provisioning).
  # Do not add a heavier import to freshness_check without moving this to $VENV/bin/python —
  # otherwise this block silently and permanently degrades to "version check unavailable".
  PUB_URL="https://raw.githubusercontent.com/TOPSinfo/drift-detector-scan/master/.claude-plugin/marketplace.json"
  INST_VER="$(python3 -c "import json;print(json.load(open('$ROOT/.claude-plugin/plugin.json')).get('version',''))" 2>/dev/null || echo '')"
  # Selects the plugins[] entry named drift-detector rather than assuming index 0, in case the
  # marketplace ever lists more than one plugin.
  PUB_VER="$(curl -fsS --max-time 5 "$PUB_URL" 2>/dev/null | python3 -c "
import json, sys
d = json.load(sys.stdin)
plugins = d.get('plugins') or []
p = next((x for x in plugins if x.get('name') == 'drift-detector'), plugins[0] if plugins else {})
print(p.get('version', ''))
" 2>/dev/null || echo '')"
  if [ -n "$PUB_VER" ]; then
    # INST_VER/PUB_VER are passed as argv, not spliced into the python source: PUB_VER comes
    # from the network, and building code by string interpolation from untrusted input is the
    # wrong shape even when today's quoting happens to degrade safely.
    PYTHONPATH="$ROOT" python3 -c "
import sys
from agent.lib import freshness_check
print('  ' + freshness_check.compare(sys.argv[1], sys.argv[2])[1])
" "$INST_VER" "$PUB_VER" 2>/dev/null \
      || echo "  drift-detector: version check unavailable"
  else
    echo "  drift-detector: could not reach the marketplace to check for updates (offline?)"
  fi
  echo
  if [ "$ready" = "1" ]; then
    echo "Ready ✓   run:  /drift-detector <folder>"
    # optional scan-readiness pre-flight for a folder (private-source packages needing access)
    if [ -n "${2:-}" ] && [ -f "$MARKER" ]; then
      echo
      env PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$VENV/bin/python" -m agent.cli preflight --root "$2" || true
      echo
      env PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" "$VENV/bin/python" -m agent.cli recommend --root "$2" || true
    fi
    exit 0
  fi
  printf 'Not ready ✗   install ONE of these, then retry:\n\n%s\n' "$_UV_HINT" >&2
  exit 3
fi

# Subcommand: default inventory-scan; others: audit / run / schedule / unschedule / doctor.
SUB="inventory-scan"
case "${1:-}" in
  audit|run|deliver|notify|chat-summary|email-summary|sbom|sarif|brief|precedents|config-preflight|schedule|unschedule|mute|preflight|recommend|absorb|absorb-report|verify|catalog-refresh|catalog-check|plan|probe|freshness|leads|adhoc-report|render|clean|research|resolve|coverage-report) SUB="$1"; shift ;;
  # A bare word we do not dispatch is a TYPO or an unwired subcommand — never the default
  # scan. Falling through silently made `drift-scan clean` die as `inventory-scan` with an
  # unrelated "--root is required", which reads as a broken scan rather than a bad verb.
  -*|"") : ;;                                   # flags / no args → the default scan
  *) echo "drift-detector: unknown subcommand '$1'. Run 'drift-scan doctor' or pass scan flags (--root/--state)." >&2; exit 2 ;;
esac

# ---------- provision the venv once (idempotent via the marker file) ----------
# Prefer uv: it creates a venv without the system python3-venv/ensurepip package
# and can fetch a suitable Python itself. Fall back to system python3.
if [ ! -f "$MARKER" ]; then
  echo "drift-detector: first-run setup — creating venv (one-time)…" >&2
  if command -v uv >/dev/null 2>&1; then
    uv venv --python "$PYVER" "$VENV" 1>&2
    VIRTUAL_ENV="$VENV" uv pip install -q -r "$REQ" 1>&2
  elif command -v "${DRIFT_PYTHON:-python3}" >/dev/null 2>&1 \
       && "${DRIFT_PYTHON:-python3}" -c 'import ensurepip, venv' 2>/dev/null; then
    "${DRIFT_PYTHON:-python3}" -m venv "$VENV"
    "$VENV/bin/python" -m pip install -q --upgrade pip 1>&2
    "$VENV/bin/python" -m pip install -q -r "$REQ" 1>&2
  else
    printf 'drift-detector: cannot provision the scanner — no usable uv/python found.\n\n%s\n\nRun  /drift-detector doctor  for a full check.\n' "$_UV_HINT" >&2
    exit 3
  fi
  touch "$MARKER"
fi

# ---------- fetch the ast-grep engine (preferred: static binary, ~90x faster) ----------
# Placed in the venv's bin/ because agent.lib.scan_util.resolve_engine looks there.
# ast-grep IS the scan engine: without it, scans cannot run. The failure is
# reported loudly rather than silently producing an empty inventory.
if [ ! -x "$VENV/bin/ast-grep" ]; then
  _os="$(uname -s)"; _arch="$(uname -m)"
  case "$_os:$_arch" in
    Linux:x86_64)   _asset="app-x86_64-unknown-linux-gnu.zip" ;;
    Linux:aarch64)  _asset="app-aarch64-unknown-linux-gnu.zip" ;;
    Darwin:arm64)   _asset="app-aarch64-apple-darwin.zip" ;;
    Darwin:x86_64)  _asset="app-x86_64-apple-darwin.zip" ;;
    *)              _asset="" ;;
  esac
  if [ -n "$_asset" ] && command -v curl >/dev/null 2>&1 && command -v unzip >/dev/null 2>&1; then
    # PINNED, not "latest": an unpinned engine means two machines can fetch DIFFERENT
    # ast-grep builds, silently changing scan output — which breaks the tool's central
    # "deterministic, byte-identical" guarantee (the rule node-kinds in AST_STRING_KINDS
    # were verified against this exact version). Bump AST_GREP_VERSION deliberately, after
    # re-verifying the ruleset. Falls back to latest only if the pin can't be resolved.
    AST_GREP_VERSION="${DRIFT_AST_GREP_VERSION:-0.44.1}"
    echo "drift-detector: fetching the ast-grep engine ${AST_GREP_VERSION} (one-time)…" >&2
    _rel="https://api.github.com/repos/ast-grep/ast-grep/releases/tags/${AST_GREP_VERSION}"
    _url=$(curl -fsSL "$_rel" 2>/dev/null \
           | grep -o "\"browser_download_url\": \"[^\"]*${_asset}\"" | cut -d'"' -f4)
    if [ -z "$_url" ]; then
      echo "drift-detector: pinned ast-grep ${AST_GREP_VERSION} not found — falling back to latest." >&2
      _url=$(curl -fsSL https://api.github.com/repos/ast-grep/ast-grep/releases/latest 2>/dev/null \
             | grep -o "\"browser_download_url\": \"[^\"]*${_asset}\"" | cut -d'"' -f4)
    fi
    if [ -n "$_url" ]; then
      _tmp=$(mktemp -d)
      if curl -fsSL -o "$_tmp/sg.zip" "$_url" && unzip -qo "$_tmp/sg.zip" -d "$_tmp" 2>/dev/null \
         && [ -f "$_tmp/ast-grep" ]; then
        mv "$_tmp/ast-grep" "$VENV/bin/ast-grep" && chmod +x "$VENV/bin/ast-grep"
      else
        echo "drift-detector: ast-grep download failed — scans will not run until it is installed." >&2
      fi
      rm -rf "$_tmp"
    fi
  fi
fi

# ---------- fetch the gitleaks secret-detection engine (optional, static binary) ----------
# Unlike ast-grep, gitleaks is OPTIONAL: agent.lib.secrets_scan degrades a missing/failing
# binary to a per-repo secretsError (secrets count reads UNKNOWN, not zero) rather than
# failing the scan — so every step below is best-effort. Every fallible command here is
# either inside an `if`/`&&` chain or explicitly `|| true`-guarded: under `set -e`, a bare
# failing command-substitution assignment (`x="$(cmd)"` where cmd fails) aborts the WHOLE
# script, which would turn "gitleaks isn't reachable" into "no scan ran at all" for
# users who never asked for secret detection. A prior version of this block got this
# wrong in exactly that way — verified fixed by tracing it with `bash -x` against a
# blackholed network, base vs. fixed.
#
# Checksums are hardcoded (one per platform), matching the Dockerfile's AST_GREP_SHA256
# discipline, not fetched from the same host as the binary — a wrong or missing checksum
# skips installing it rather than trusting unverified code, and it also means no GitHub
# API call is needed to find the download URL (release URLs are a fixed, predictable
# pattern), which is the other thing that made this block fragile before.
GITLEAKS_FETCH_MARKER="$VENV/.gitleaks-fetch-attempted"
if [ ! -x "$VENV/bin/gitleaks" ] && ! command -v gitleaks >/dev/null 2>&1 \
   && [ ! -f "$GITLEAKS_FETCH_MARKER" ]; then
  # Attempted once per venv, success or failure — an optional feature must not re-pay a
  # network round-trip on every single scan invocation forever just because one machine
  # has chosen not to install it. Delete this marker (or the venv) to retry.
  touch "$GITLEAKS_FETCH_MARKER" 2>/dev/null || true
  _os_gl="$(uname -s)"; _arch_gl="$(uname -m)"
  # PINNED, not "latest" — same determinism argument as AST_GREP_VERSION above.
  GITLEAKS_VERSION="${DRIFT_GITLEAKS_VERSION:-8.30.1}"
  case "$_os_gl:$_arch_gl" in
    Linux:x86_64)
      _asset_gl="linux_x64.tar.gz"
      _sha_gl="551f6fc83ea457d62a0d98237cbad105af8d557003051f41f3e7ca7b3f2470eb" ;;
    Linux:aarch64)
      _asset_gl="linux_arm64.tar.gz"
      _sha_gl="e4a487ee7ccd7d3a7f7ec08657610aa3606637dab924210b3aee62570fb4b080" ;;
    Darwin:arm64)
      _asset_gl="darwin_arm64.tar.gz"
      _sha_gl="b40ab0ae55c505963e365f271a8d3846efbc170aa17f2607f13df610a9aeb6a5" ;;
    Darwin:x86_64)
      _asset_gl="darwin_x64.tar.gz"
      _sha_gl="dfe101a4db2255fc85120ac7f3d25e4342c3c20cf749f2c20a18081af1952709" ;;
    *)
      _asset_gl="" ;;
  esac
  # Shas above are gitleaks 8.30.1's own published checksums for these 4 assets,
  # independently re-verified against the downloaded bytes when this block was written
  # (not copied blind from the checksums file) — bump both together, deliberately.
  if [ -n "$_asset_gl" ] && command -v curl >/dev/null 2>&1 && command -v tar >/dev/null 2>&1 \
     && command -v sha256sum >/dev/null 2>&1; then
    _asset_name_gl="gitleaks_${GITLEAKS_VERSION}_${_asset_gl}"
    _url_gl="https://github.com/gitleaks/gitleaks/releases/download/v${GITLEAKS_VERSION}/${_asset_name_gl}"
    _tmp_gl=$(mktemp -d)
    if curl -fsSL --max-time 20 -o "$_tmp_gl/$_asset_name_gl" "$_url_gl" 2>/dev/null \
       && echo "${_sha_gl}  $_tmp_gl/$_asset_name_gl" | sha256sum -c - >/dev/null 2>&1 \
       && tar -xzf "$_tmp_gl/$_asset_name_gl" -C "$_tmp_gl" gitleaks 2>/dev/null \
       && [ -f "$_tmp_gl/gitleaks" ]; then
      mv "$_tmp_gl/gitleaks" "$VENV/bin/gitleaks" && chmod +x "$VENV/bin/gitleaks"
      echo "drift-detector: fetched gitleaks ${GITLEAKS_VERSION} (checksum verified)" >&2
    else
      echo "drift-detector: gitleaks fetch or checksum verification failed — secret detection will report UNKNOWN until it is installed manually." >&2
    fi
    rm -rf "$_tmp_gl"
  fi
fi

# Run from the caller's cwd (so relative paths resolve), with the agent package on the
# import path. The venv's python finds ast-grep and gitleaks next to it
# (agent.lib.scan_util.resolve_engine / agent.lib.secrets_scan._resolve_gitleaks check
# dirname(sys.executable)).
exec env PYTHONSAFEPATH=1 PYTHONPATH="$ROOT${PYTHONPATH:+:$PYTHONPATH}" \
  "$VENV/bin/python" -m agent.cli "$SUB" "$@"
